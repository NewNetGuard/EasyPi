# EasyPi Sudoers Configuration
# Location: /etc/sudoers.d/easypi
# Permissions: root:root 0440 (chmod 0440)
#
# This file allows EasyPi users to execute necessary commands
# with root privileges without requiring a password.
#
# Security:
# - Only specific commands are permitted without password
# - The runner script validates and restricts which scripts can be run
#
# Installation: This file is automatically configured by install_easypi.sh
# The %easypi group is created during installation and users are added to it

# ============ Command Aliases ============

# Runner script for task execution
Cmnd_Alias EASYPI_RUNNER = /opt/EasyPi/scripts/runner, /opt/EasyPi/scripts/runner *

# AI/Ollama management. CLI calls are unprivileged; only the fixed service unit
# may be controlled as root.
Cmnd_Alias EASYPI_AI = /usr/bin/systemctl start ollama, /usr/bin/systemctl stop ollama, /usr/bin/systemctl restart ollama, /usr/bin/systemctl enable ollama, /usr/bin/systemctl disable ollama, /bin/systemctl start ollama, /bin/systemctl stop ollama, /bin/systemctl restart ollama, /bin/systemctl enable ollama, /bin/systemctl disable ollama

# Security service commands
Cmnd_Alias EASYPI_SECURITY = /usr/bin/cat /etc/ssh/sshd_config, /usr/sbin/sshd -T, /usr/bin/systemctl restart ssh, /usr/bin/systemctl restart sshd, /bin/systemctl restart ssh, /bin/systemctl restart sshd, /usr/bin/apt update, /usr/bin/apt-get update, /usr/bin/dpkg --configure -a

# Package installation used by backend services. Do not allow local .deb paths.
Cmnd_Alias EASYPI_PACKAGES = /usr/bin/apt-get install -y ufw, /usr/bin/apt-get install -y -qq ffmpeg

# Backup creation and restoration go through validated root-owned scripts.
Cmnd_Alias EASYPI_BACKUP = /usr/bin/ls /opt/EasyPi/backups, /bin/ls /opt/EasyPi/backups

# System daemon reload
Cmnd_Alias EASYPI_SYSTEMD = /usr/bin/systemctl daemon-reload, /bin/systemctl daemon-reload

# Installer instances are started through the strict runner wrapper
# services/start_installer_job.sh; no systemctl wildcard is granted here.

# Tailscale CLI mutations and forwarding go through validated runner scripts.
Cmnd_Alias EASYPI_TAILSCALE = /usr/bin/systemctl enable tailscaled, /usr/bin/systemctl start tailscaled, /usr/bin/systemctl stop tailscaled, /usr/bin/systemctl restart tailscaled, /bin/systemctl enable tailscaled, /bin/systemctl start tailscaled, /bin/systemctl stop tailscaled, /bin/systemctl restart tailscaled

# Gateway mode management (for full gateway functionality)
# Fixed file installation and chmod actions go through scripts/runner settings/gateway_config.sh.
Cmnd_Alias EASYPI_GATEWAY = /opt/EasyPi/scripts/setup/gateway_fix.sh, /usr/bin/systemctl enable --now easypi-gateway-fix.timer, /bin/systemctl enable --now easypi-gateway-fix.timer, /usr/bin/systemctl disable --now easypi-gateway-fix.timer, /bin/systemctl disable --now easypi-gateway-fix.timer

# Monitoring tools. Every privileged invocation is an exact read-only command;
# journalctl, dmesg and ss run unprivileged to avoid arbitrary --file inputs.
Cmnd_Alias EASYPI_MONITOR = /usr/sbin/conntrack -L, /usr/sbin/conntrack -L -o extended, /usr/sbin/iptables -L -n -v -x, /usr/sbin/iptables -L INPUT -n, /usr/sbin/iptables -L ufw-user-input -n -v -x, /usr/sbin/iptables -L ufw-user-forward -n -v -x, /usr/sbin/iptables -L ufw-user-output -n -v -x, /usr/sbin/iptables -t nat -S PREROUTING, /usr/sbin/iptables -t nat -S POSTROUTING, /usr/sbin/iptables -t nat -L POSTROUTING -n, /usr/sbin/ip6tables -L INPUT -n, /usr/sbin/ip6tables -L ufw-user-input -n -v -x, /usr/sbin/ip6tables -L ufw-user-forward -n -v -x, /usr/sbin/ip6tables -L ufw-user-output -n -v -x
Defaults!EASYPI_MONITOR noexec

# NetProtection DNS service management
Cmnd_Alias EASYPI_NETPROTECTION = /usr/bin/systemctl start easypi-netprotection, /usr/bin/systemctl stop easypi-netprotection, /usr/bin/systemctl restart easypi-netprotection, /usr/bin/systemctl enable easypi-netprotection, /usr/bin/systemctl disable easypi-netprotection, /bin/systemctl start easypi-netprotection, /bin/systemctl stop easypi-netprotection, /bin/systemctl restart easypi-netprotection, /bin/systemctl enable easypi-netprotection, /bin/systemctl disable easypi-netprotection


# go2rtc configuration is generated by settings/go2rtc_config.sh after validating
# stream names and RTSP URLs. The backend cannot install arbitrary YAML.
Cmnd_Alias EASYPI_GO2RTC = /usr/bin/systemctl reload go2rtc, /usr/bin/systemctl restart go2rtc, /usr/bin/systemctl start go2rtc, /usr/bin/systemctl stop go2rtc, /bin/systemctl reload go2rtc, /bin/systemctl restart go2rtc, /bin/systemctl start go2rtc, /bin/systemctl stop go2rtc

# Permissions checks (sudoers presence)
Cmnd_Alias EASYPI_PERMS = /usr/bin/test -f /etc/sudoers.d/easypi, /bin/test -f /etc/sudoers.d/easypi, /usr/bin/true, /bin/true

# ============ Permission Rules ============

# Only the backend service account receives passwordless privileges. Membership
# in the easypi data-sharing group must not imply root command execution.
easypi ALL=(root) NOPASSWD: EASYPI_RUNNER, EASYPI_AI, EASYPI_SECURITY, EASYPI_BACKUP, EASYPI_SYSTEMD, EASYPI_TAILSCALE, EASYPI_GATEWAY, EASYPI_PACKAGES, EASYPI_MONITOR, EASYPI_PERMS, EASYPI_NETPROTECTION, EASYPI_GO2RTC
