# FastAPI port
API_PORT=8000
# Vite preview port
FRONTEND_PORT=4173
# production|development
ENV=production
# Keep backend bound to loopback behind nginx in production
API_HOST=127.0.0.1
# debug|info|warning|error
LOG_LEVEL=info

# JWT/signing secret (min 32 bytes)
SECRET_KEY=change_me_32_bytes_min

# Default database is SQLite; Postgres can be configured later
DATABASE_URL=sqlite:///./data/db/easypi.db

# Base paths for WebSocket/HTTP
API_BASE=/api/v1
WS_BASE=/ws

# Production hardening
ENABLE_API_DOCS=false
ALLOW_DEV_CORS=false

# Optional comma-separated exact Web Push provider hosts or leading-dot suffixes.
# Chrome/Firefox/Safari/Windows production providers are allowed by default.
EASYPI_WEBPUSH_ALLOWED_HOSTS=

# Privileged runner configuration
SCRIPTS_ROOT=/opt/EasyPi/scripts
RUNNER_PATH=/opt/EasyPi/scripts/runner
TASK_LOG_DIR=/opt/EasyPi/logs/tasks

# NetProtection Home (Pi-Guard)
# If NetProtection runs on the host and backend is in Docker, use host gateway (e.g. http://host.docker.internal:3000 or http://172.17.0.1:3000)
NETPROTECTION_URL=http://127.0.0.1:5354
# Trusted installer location for admin-triggered NetProtection installs
NETPROTECTION_INSTALL_SCRIPT_URL=https://raw.githubusercontent.com/NetProtectionTeam/NetProtectionHome/master/scripts/install.sh
# SHA-256 checksum for the trusted NetProtection installer script
NETPROTECTION_INSTALL_SCRIPT_SHA256=
# REMOVED: NetProtection_USERNAME
# REMOVED: NetProtection_PASSWORD

# Optional default checksum for URL-based updates run through update.sh
EASYPI_UPDATE_SHA256=
