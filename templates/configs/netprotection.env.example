# EasyPi NetProtection Environment Configuration
# This file contains sensitive configuration that should NOT be in version control

# Salt for IP anonymization (32 hex chars recommended)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NETPROTECTION_CHRONICLE__HASH_SALT=your_secret_salt_here

# Override listener port (optional)
# NETPROTECTION_LISTENER__PORT=5454

# Debug mode (optional)
# NETPROTECTION_DEBUG=false
