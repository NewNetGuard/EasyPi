[Unit]
Description=EasyPi Chameleon Mobile Link Agent
After=network-online.target nginx.service easypi-backend.service
Wants=network-online.target nginx.service easypi-backend.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=easypi-mobile-link
Group=easypi-mobile-link
UMask=0077
ExecStart=/opt/EasyPi/bin/chameleon-mobile-link-agent -config /etc/easypi-mobile-link/agent.json
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
