# Runtime-downloaded third-party feeds and their generated provenance sidecars.
# These must never be committed or bundled into an EasyPi release.
adult_domains.txt
adult_domains.NOTICE.txt
adult_domains.LICENSE.txt
adult_domains.sources.json
# Stray SQLite DBs in the data root (test/temp artifacts — must never be tracked
# or synced to a server; the real DB lives under data/db/).
data/*.db
data/*.db-shm
data/*.db-wal

# Offline ML training corpora (large generated data blobs, not code — the live
# on-device model trains itself from flow_log.db, no need to track these).
data/ml_train/

# Stray probe DB at the repo root (test/temp artifact — must never be tracked).
/_probe.db

