# Local temp files
temp_config.json
data/.setup_token
tools/vs_BuildTools.exe

# Release signing PRIVATE key — must NEVER be committed. The real key lives
# outside the repo (~/.easypi-signing/); these are a safety net in case a copy
# ever lands in the project. The PUBLIC key (*.pub) is intentionally NOT ignored
# — it ships with EasyPi so devices can verify updates.
*.key
update_signing.key
.easypi-signing/

# Public source copy: never publish local credentials or traffic/recovery data
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.secret
*.credentials
*.epikey
*.epibak
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.pcap
*.pcapng
*.har
*.dump
.ssh/
